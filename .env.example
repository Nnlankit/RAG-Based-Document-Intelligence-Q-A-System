APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Ollama LLM & Embeddings
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Vector Storage: Neon PgVector
VECTOR_STORE=pgvector
COLLECTION_NAME=documents_v1_nomic_embed_text

# Database: Neon PostgreSQL
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-sample.neon.tech/neondb?sslmode=require

# Document Ingestion & Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# Retrieval & Grounding
TOP_K=5
RETRIEVAL_CANDIDATES=20
SIMILARITY_THRESHOLD=0.70
ENABLE_RERANKER=false
ENABLE_QUERY_REWRITING=true
ENABLE_HYBRID_SEARCH=false

# Security & Auth (Phase 10)
SECRET_KEY=change-this-secret-key-in-production-random-uuid-or-hash
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Observability & Logging
LOG_LEVEL=INFO
